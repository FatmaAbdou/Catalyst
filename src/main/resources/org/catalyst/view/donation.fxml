<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.catalyst.controller.DonationController" styleClass="page">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="top-bar">
            <padding><Insets top="14" right="36" bottom="14" left="36"/></padding>
            <Button text="←  Home" onAction="#openWelcome" styleClass="nav-button"/>
            <Label text="✿" styleClass="brand-mark"/>
            <Label text="catalyst" styleClass="brand"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="form-scroll">
            <content>
                <VBox alignment="TOP_CENTER" styleClass="form-page">
                    <padding><Insets top="28" right="20" bottom="40" left="20"/></padding>
                    <VBox alignment="CENTER" spacing="13" maxWidth="520" styleClass="form-card">
                        <Label text="✦  GIVE" styleClass="eyebrow"/>
                        <Label text="Make a donation" styleClass="form-title"/>
                        <Label text="Every gift helps a neighbor in need." styleClass="body-copy"/>
                        <VBox fx:id="donorEmailSection" spacing="6" maxWidth="Infinity">
                            <TextField fx:id="donorEmailField" promptText="✉  Donor's email address" styleClass="input-field"/>
                        </VBox>
                        <ComboBox fx:id="typeBox" maxWidth="Infinity" styleClass="input-field"/>
                        <VBox fx:id="monetarySection" spacing="13" maxWidth="Infinity">
                            <TextField fx:id="amountField" promptText="Amount" styleClass="input-field"/>
                            <ComboBox fx:id="methodBox" maxWidth="Infinity" styleClass="input-field"/>
                            <VBox fx:id="paymentDetailSection" spacing="6" maxWidth="Infinity">
                                <TextField fx:id="paymentDetailField" styleClass="input-field"/>
                            </VBox>
                        </VBox>
                        <VBox fx:id="inKindSection" spacing="13" maxWidth="Infinity">
                            <TextField fx:id="itemField" promptText="What are you donating?" styleClass="input-field"/>
                            <TextField fx:id="quantityField" promptText="Quantity" styleClass="input-field"/>
                            <TextField fx:id="unitField" promptText="Unit (for example boxes, kg, pieces)" styleClass="input-field"/>
                            <TextField fx:id="conditionField" promptText="Condition (optional)" styleClass="input-field"/>
                        </VBox>
                        <Label fx:id="messageLabel" minHeight="20" wrapText="true" styleClass="message-label"/>
                        <Button fx:id="submitButton" text="Donate  →" onAction="#submitDonation" maxWidth="Infinity" styleClass="primary-button"/>
                        <TextArea fx:id="receiptArea" editable="false" wrapText="true" prefRowCount="16" styleClass="receipt-area"/>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
