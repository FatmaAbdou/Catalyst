<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.catalyst.controller.BeneficiaryFormController"
            styleClass="page">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="top-bar">
            <padding>
                <Insets top="16" right="32" bottom="16" left="32"/>
            </padding>

            <Label text="catalyst" styleClass="brand"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Label fx:id="officerLabel" styleClass="small-copy"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="form-scroll">
            <content>
                <VBox alignment="TOP_CENTER">
                    <padding>
                        <Insets top="28" right="32" bottom="28" left="32"/>
                    </padding>

                    <VBox spacing="12" maxWidth="620" styleClass="form-card">
                        <Label fx:id="titleLabel"
                               text="Create beneficiary"
                               styleClass="form-title"/>

                        <Label text="Name and household size are required."
                               styleClass="small-copy"/>

                        <Label text="Name *" styleClass="field-label"/>
                        <TextField fx:id="nameField"
                                   accessibleText="Beneficiary name"
                                   styleClass="input-field"/>

                        <Label text="Contact information" styleClass="field-label"/>
                        <TextField fx:id="contactField"
                                   accessibleText="Contact information"
                                   styleClass="input-field"/>

                        <Label text="Household size *" styleClass="field-label"/>
                        <TextField fx:id="householdSizeField"
                                   promptText="Number of household members"
                                   accessibleText="Household size"
                                   styleClass="input-field"/>

                        <Label text="Needs" styleClass="field-label"/>
                        <TextArea fx:id="needsField"
                                  accessibleText="Beneficiary needs"
                                  wrapText="true"
                                  styleClass="input-field"
                                  style="-fx-pref-height: 110;"/>

                        <Label fx:id="messageLabel"
                               minHeight="20"
                               wrapText="true"
                               styleClass="message-label"/>

                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Button fx:id="cancelButton"
                                    text="Cancel"
                                    onAction="#cancel"
                                    styleClass="nav-button"/>
                            <Button fx:id="saveButton"
                                    text="Create beneficiary"
                                    onAction="#save"
                                    styleClass="primary-button"/>
                        </HBox>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
