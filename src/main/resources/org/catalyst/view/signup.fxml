<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.catalyst.controller.SignUpController" styleClass="page">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="top-bar">
            <padding><Insets top="14" right="36" bottom="14" left="36"/></padding>
            <Button text="←  Home" onAction="#openWelcome" styleClass="nav-button"/>
            <Label text="✿" styleClass="brand-mark"/>
            <Label text="catalyst" styleClass="brand"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Label text="Already a member?" styleClass="small-copy"/>
            <Button text="Log in  →" onAction="#openLogin" styleClass="text-button"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="form-scroll">
            <content>
                <VBox alignment="TOP_CENTER" styleClass="form-page">
                    <padding><Insets top="28" right="20" bottom="40" left="20"/></padding>
                    <VBox alignment="CENTER" spacing="13" maxWidth="470" styleClass="form-card">
                        <Label text="✦  MAKE A DIFFERENCE" styleClass="eyebrow"/>
                        <Label text="Create your account" styleClass="form-title"/>
                        <Label text="Join a community that cares." styleClass="body-copy"/>
                        <TextField fx:id="nameField" promptText="♙  Full name" styleClass="input-field"/>
                        <TextField fx:id="emailField" promptText="✉  Email address" styleClass="input-field"/>
                        <TextField fx:id="contactField" promptText="☎  Phone number (optional)" styleClass="input-field"/>
                        <ComboBox fx:id="userTypeBox" maxWidth="Infinity" styleClass="input-field"/>
                        <VBox fx:id="organizationSection" spacing="6" maxWidth="Infinity">
                            <TextField fx:id="organizationField" promptText="▤  Organization name (optional)" styleClass="input-field"/>
                        </VBox>
                        <PasswordField fx:id="passwordField" promptText="▣  Password (at least 10 characters)" styleClass="input-field"/>
                        <PasswordField fx:id="confirmPasswordField" promptText="▣  Confirm password" styleClass="input-field"/>
                        <Label fx:id="messageLabel" minHeight="20" wrapText="true" styleClass="message-label"/>
                        <Button text="Create account  →" onAction="#createAccount" maxWidth="Infinity" styleClass="primary-button"/>
                        <Label text="Your password is securely protected." styleClass="secure-note"/>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
