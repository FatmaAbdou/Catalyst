<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.catalyst.controller.BeneficiaryListController"
            styleClass="page">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="top-bar">
            <padding>
                <Insets top="16" right="32" bottom="16" left="32"/>
            </padding>

            <Button text="Home"
                    onAction="#openHome"
                    styleClass="nav-button"/>

            <Label text="catalyst" styleClass="brand"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Label fx:id="officerLabel" styleClass="small-copy"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="16">
            <padding>
                <Insets top="28" right="32" bottom="28" left="32"/>
            </padding>

            <Label text="Beneficiaries" styleClass="form-title"/>
            <Label text="Find households and review their recorded needs."
                   styleClass="body-copy"/>

            <HBox spacing="10">
                <Button text="Create beneficiary"
                        onAction="#createBeneficiary"
                        styleClass="primary-button"/>
                <Button fx:id="editButton"
                        text="Edit selected"
                        onAction="#editBeneficiary"
                        styleClass="nav-button"/>
                <Button fx:id="detailsButton"
                        text="View details"
                        onAction="#viewDetails"
                        styleClass="nav-button"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <TextField fx:id="searchField"
                           promptText="Search name, contact information, or needs"
                           accessibleText="Search beneficiaries"
                           onAction="#search"
                           HBox.hgrow="ALWAYS"
                           styleClass="input-field"/>

                <Button text="Search"
                        onAction="#search"
                        styleClass="primary-button"/>

                <Button text="Refresh"
                        onAction="#refresh"
                        styleClass="nav-button"/>
            </HBox>

            <Label fx:id="messageLabel"
                   wrapText="true"
                   styleClass="message-label"/>

            <TableView fx:id="beneficiariesTable" VBox.vgrow="ALWAYS" styleClass="beneficiary-table">
                <columns>
                    <TableColumn fx:id="nameColumn"
                                 text="Name"
                                 prefWidth="220"/>
                    <TableColumn fx:id="contactColumn"
                                 text="Contact information"
                                 prefWidth="200"/>
                    <TableColumn fx:id="householdColumn"
                                 text="Household size"
                                 prefWidth="120"/>
                    <TableColumn fx:id="needsColumn"
                                 text="Needs"
                                 prefWidth="350"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
